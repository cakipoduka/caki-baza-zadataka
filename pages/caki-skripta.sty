\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{caki-skripta}[2026/11/04 CAKI skripta - stil za tiskane skripte]

% ============================================================
%  CAKI SKRIPTA — stil (4.11.2026.)
%
%  NASLJEĐUJE caki-style.sty (isti onaj koji koristi Test Builder) — zato
%  skripta automatski dobiva SVE što je ondje već izborjeno i provjereno u
%  produkciji:
%    - margine 1.3 cm (maksimalna iskoristivost papira)
%    - \DeclareMathSizes{10.95}{14}{10}{7} (POVEĆANE matematičke formule, tekst
%      ostaje normalne veličine — Caki slabije vidi)
%    - newunicodechar mape (∪ ∩ ≤ ⟨ ⟩ … upisani izravno u Sheet ne ruše build)
%    - \overparen definiran bez ijednog novog CTAN paketa (yhmath NE postoji na
%      produkciji — v. §3c u caki-style.sty, ne vraćati)
%    - \mcFourOptions / \cakislike / \cakislikeopcije, qrcode, tcolorbox, babel
%
%  OVDJE se dodaje SAMO ono po čemu se skripta razlikuje od testa:
%    1. crn tekst (naslovi u skripti nisu plavi)
%    2. naslov cjeline CENTRIRAN, uvećan, istaknut, na novoj stranici
%    3. blok teorije i blok formula ispod naslova cjeline
%    4. razdjelni simbol između primjera i zadataka
%    5. rješenja NA KRAJU SVAKOG POGLAVLJA (ne na kraju dokumenta)
%
%  VAŽNO: numeriranje (oznake „3.1.", „P2.", …) NE radi LaTeX brojačima nego ga
%  generira Python (skripta_latex.py) i predaje kao argument. Razlog: rješenja na
%  kraju poglavlja moraju nositi TOČNO iste oznake kao zadaci, a to je pouzdanije
%  izračunati u Pythonu (gdje se i tako zna cijeli raspored) nego sinkronizirati
%  dva LaTeX brojača kroz \input datoteke.
% ============================================================

\RequirePackage{caki-style}

% --- 1. CRN TEKST (Caki 4.11.2026., izričit zahtjev) -------------------------
% caki-style.sty boji naslove/oznake tamnoplavom (MathPrimary) i kraljevsko
% plavom (MathAccent). U SKRIPTI tekst mora biti crn (čitljivost + toner pri
% ispisu većeg broja stranica). Redefiniranjem SAMIH BOJA (umjesto prepravljanja
% svake naredbe) sve naslijeđene naredbe iz caki-style.sty odmah postaju crne,
% a strukturni elementi (trake, crte) zadržavaju oblik.
% AKO ikad zatreba plava natrag: zakomentiraj iduće tri linije.
\definecolor{MathPrimary}{HTML}{000000}
\definecolor{MathAccent}{HTML}{000000}
\definecolor{MathSecondary}{HTML}{000000}
\definecolor{TextDark}{HTML}{000000}
% Žuta ostaje JEDINA boja u dokumentu — traka s brojem zadatka (preuzeto iz
% trenutne PreTeXt skripte, Caki ju je ondje tražio 30.10.2026.).
\definecolor{CakiZuta}{HTML}{F2C200}

% --- 2. GEOMETRIJA: obostrani ispis s uvezom ili simetrične margine ----------
% caki-style.sty već učitava geometry s fiksnim opcijama; geometry dopušta
% naknadnu promjenu preko \geometry{...}, pa se paket NE učitava drugi put
% (to bi dalo "Option clash for package geometry" i srušilo build).
%
% \cakiuvez — za OBOSTRANI ispis i žičani uvez po dužem rubu: UNUTARNJA margina
%   veća od vanjske, pa uvez nikad ne pojede tekst ni na prednjoj ni na stražnjoj
%   strani lista. Zahtijeva \documentclass[...,twoside].
% \cakibezuveza — jednostrani ispis: simetrične 1.3 cm margine (kao test).
\newcommand{\cakiuvez}{\geometry{a4paper,twoside,inner=1.9cm,outer=1.0cm,top=1.2cm,bottom=1.4cm}}
\newcommand{\cakibezuveza}{\geometry{a4paper,top=1.3cm,bottom=1.3cm,left=1.3cm,right=1.3cm}}

% --- 3. ZAGLAVLJE I PODNOŽJE ------------------------------------------------
% caki-style.sty postavlja zaglavlje "MATEMATIKA · ZBIRKA ZADATAKA" i podnožje s
% brendom. Za skriptu: u zaglavlju naziv skripte (lijevo) i tekuća cjelina
% (desno), broj stranice na VANJSKOM rubu (bitno za obostrani ispis).
\newcommand{\cakiskriptazaglavlje}[1]{%
    \fancyhf{}%
    \fancyhead[L]{\small\sffamily\bfseries\color{MathPrimary} #1}%
    \fancyhead[R]{\small\sffamily\color{TextDark}\nouppercase{\rightmark}}%
    % broj stranice na vanjskom rubu: parne lijevo, neparne desno (twoside)
    \fancyfoot[LE,RO]{\small\sffamily\bfseries\color{MathPrimary} \thepage}%
    \fancyfoot[RE,LO]{\tiny\sffamily\color{gray}%
        \href{https://www.cakipoduka.com}{www.cakipoduka.com} \textbullet\ Caki centar d.o.o.}%
    % Stil "plain" koristi PRVA stranica (naslovni blok) i svaka stranica nakon
    % \clearpage iz \cakicjelina. Bez ovoga bi ondje bio LaTeX-ov zadani plain
    % (broj stranice CENTRIRAN na dnu, bez brenda) - provjereno na probnom PDF-u
    % 4.11.2026. Zaglavlje se na tim stranicama namjerno NE ispisuje (naslov je
    % ionako tu, odmah ispod), ali podnožje s brendom i brojem stranice ostaje.
    \fancypagestyle{plain}{%
        \fancyhf{}%
        \renewcommand{\headrulewidth}{0pt}%
        \fancyfoot[LE,RO]{\small\sffamily\bfseries\color{MathPrimary} \thepage}%
        \fancyfoot[RE,LO]{\tiny\sffamily\color{gray}%
            \href{https://www.cakipoduka.com}{www.cakipoduka.com} \textbullet\ Caki centar d.o.o.}%
    }%
    \pagestyle{fancy}%
}

% --- 4. NASLOVNI BLOK SKRIPTE -----------------------------------------------
% \cakiskriptahead{naslov}{podnaslov ili prazno}{datum/oznaka ili prazno}
%                 {legenda težina ili prazno}
% Podaci o firmi (letterhead) — isti obrazac kao \cakiispithead u caki-style.sty
% (Caki ih je ondje tražio 8.10.2026.), ovdje zadržani na izričit zahtjev.
\newcommand{\cakiskriptahead}[4]{%
    \thispagestyle{plain}%
    \begin{flushright}
        {\tiny\sffamily\color{gray} Caki centar d.o.o. \textbullet\
         \href{https://www.cakipoduka.com}{www.cakipoduka.com} \textbullet\ kontakt: 095 9005611}
    \end{flushright}
    \vspace{1mm}
    \begin{center}
        {\color{MathPrimary}\sffamily\bfseries\LARGE #1}%
        \ifblank{#2}{}{\par\vspace{1.5mm}{\sffamily\large\color{TextDark} #2}}%
        \ifblank{#3}{}{\par\vspace{1.5mm}{\small\sffamily\color{TextDark} #3}}%
        \ifblank{#4}{}{\par\vspace{1.5mm}{\footnotesize\sffamily\color{gray} #4}}%
    \end{center}
    \vspace{2mm}\hrule height 1pt \color{MathPrimary}
    \vspace{4mm}
}

% --- 5. NASLOV CJELINE (centriran, uvećan, istaknut) ------------------------
% \cakicjelina{oznaka ili prazno}{naslov}
% Na izričit zahtjev (4.11.2026.): "naslov cjeline na sredini stranice uvećanog
% fonta - istaknuto". Svaka cjelina počinje na NOVOJ stranici, OSIM prve (inače
% bi odmah iza naslovnog bloka došla prazna stranica).
%
% Isti trik kao u skripta_build.STIL_PREAMBULA (30.10.2026.): bez \if uvjeta —
% prvi poziv samo prebaci \cakiprvacjelina na \cakisljedecacjelina. Uvjet unutar
% LaTeX hooka puca s "Incomplete \iffalse", pa se NE koristi.
\newcommand{\cakisljedecacjelina}{\clearpage}
\newcommand{\cakiprvacjelina}{\global\let\cakiprvacjelina\cakisljedecacjelina}
% 5.11.2026. (Caki, „puno praznih stranica"): prekidač koji ukida prijelom stranice po
% cjelini - cjeline se tada nižu jedna za drugom, s većim razmakom. Poziva se u preambuli
% (predložak), PRIJE prve cjeline, pa \cakiprvacjelina preuzme novo značenje.
\newcommand{\cakicjelinebezprijeloma}{%
    \renewcommand{\cakisljedecacjelina}{\par\addvspace{10mm}}%
}
\newcommand{\cakicjelina}[2]{%
    \cakiprvacjelina
    \markright{#2}%
    % U sadržaj (\tableofcontents) ide puna oznaka + naslov. MORA biti NAKON prijeloma
    % stranice, inače bi zapisalo broj PRETHODNE stranice.
    \addcontentsline{toc}{section}{\ifblank{#1}{}{#1\ \ }#2}%
    \par\addvspace{2mm}
    \begin{center}
        {\color{MathPrimary}\sffamily\bfseries\Huge
         \ifblank{#1}{}{#1\ \ }#2\par}
    \end{center}
    \vspace{2mm}\hrule height 1.2pt \color{MathPrimary}
    \vspace{4mm}
}

% --- 5b. SADRŽAJ (5.11.2026., na Cakijev upit) ------------------------------
% Pravi LaTeX-ov \tableofcontents, s BROJEVIMA STRANICA - stavke u njega upisuje
% \cakicjelina preko \addcontentsline (v. gore). Naslov („Sadržaj") dolazi iz babela, pa
% se ne tipka ovdje.
%
% VAŽNO: za točne brojeve stranica treba TRI prolaza pdflatexa (1. skupi stavke u .toc,
% 2. ubaci sadržaj - čime se sve pomakne, 3. ispravi brojeve). Stranica
% pages/19_skripta_latex.py zato pokreće treći prolaz kad je sadržaj uključen.
\newcommand{\cakisadrzaj}{%
    \begingroup
    \renewcommand{\contentsname}{\normalfont\sffamily\bfseries\Large Sadr\v{z}aj}%
    \setlength{\parskip}{0pt}%
    \tableofcontents
    \endgroup
    % Sadržaj je svoja stranica — prva cjelina kreće čisto. \cakiprvacjelina prvi put ne
    % radi prijelom, pa ovdje nema dvostrukog preskakanja stranice.
    \clearpage
}

% --- 6. PODNASLOV UNUTAR CJELINE ("Primjeri", "Zadaci", "Rješenja") ---------
\newcommand{\cakipodnaslovskripte}[1]{%
    \par\addvspace{3mm}
    \noindent{\color{MathPrimary}\sffamily\bfseries\large #1}%
    \par\vspace{1.5mm}
}

% --- 7. BLOK TEORIJE --------------------------------------------------------
% Dolazi ODMAH ISPOD naslova cjeline (Caki 4.11.2026.). breakable — teorija zna
% biti duga i mora smjeti prijeći na sljedeću stranicu (bez toga tcolorbox puca
% s "Overfull" / izgubljenim sadržajem).
\newtcolorbox{cakiteorijaokvir}{
    enhanced, breakable,
    colback=MathBgLight, colframe=MathBorder,
    boxrule=0.6pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    before skip=2mm, after skip=3mm,
    before upper={\raggedright},
}
\newcommand{\cakiteorija}[1]{%
    \begin{cakiteorijaokvir}
        #1
    \end{cakiteorijaokvir}
}
% Markup iz teorija_markup.py (!!...!! i \pojam{...}) — v. teorija_u_latex_odlomke.
% U PreTeXt putu to su <alert>/<term>; ovdje su podebljanje i kurziv (boja je
% ionako crna, pa se isticanje mora vidjeti oblikom slova, ne bojom).
\newcommand{\cakiistakni}[1]{\textbf{#1}}
\newcommand{\cakipojam}[1]{\textbf{\itshape #1}}
% [RJESENJE] blok iz teorije — SAMO u verziji za profesora (Python ga u
% učeničkoj verziji uopće ne ispisuje).
\newcommand{\cakiteorijarjesenje}[1]{%
    \par\vspace{1.5mm}
    \noindent{\footnotesize\sffamily\bfseries\color{MathPrimary} Rješenje (za profesora):}~{\footnotesize #1}%
    \par\vspace{1.5mm}
}

% --- 8. BLOK FORMULA --------------------------------------------------------
% Formule iz taba `Formule` u bazi (iste koje Test Builder nudi učeniku u portalu)
% + ručno upisan blok sa stranice Skripta (LaTeX). Ide ispod teorije, prije
% primjera.
\newtcolorbox{cakiformuleokvir}[1][]{
    enhanced, breakable,
    colback=white, colframe=MathPrimary,
    boxrule=0.8pt, arc=2pt,
    left=8pt, right=8pt, top=5pt, bottom=5pt,
    before skip=2mm, after skip=3mm,
    #1
}
\newcommand{\cakiformule}[1]{%
    \begin{cakiformuleokvir}
        #1
    \end{cakiformuleokvir}
}
% \cakiformula{naziv ili prazno}{LaTeX formule — već u $...$ ili \[...\] obliku}
% Naziv je sitan i iznad formule, da formula ostane vizualno dominantna
% (matematika je ionako povećana preko \DeclareMathSizes).
\newcommand{\cakiformula}[2]{%
    \ifblank{#1}{}{\par\noindent{\footnotesize\sffamily\bfseries #1}\par\vspace{-1mm}}%
    #2
    \par\vspace{1mm}
}

% --- 9. RAZDJELNIK PRIMJERI -> ZADACI ---------------------------------------
% Na izričit zahtjev (4.11.2026.): "Kad završe primjeri napraviti neku oznaku/
% simbol kojim se paragraf i ostali zadaci razdvajaju od zadataka."
% NAMJERNO bez novog paketa (pifont/fontawesome nisu zajamčeni na produkciji —
% v. lekciju s yhmath u caki-style.sty §3c): tri rombića su iz amssymb, koji je
% već učitan i radi.
\newcommand{\cakirazdjelnik}{%
    \par\addvspace{3mm}
    \begin{center}
        {\color{MathPrimary}$\diamond$\quad$\diamond$\quad$\diamond$}
    \end{center}
    \vspace{2mm}
}

% --- 10. PRIMJER ------------------------------------------------------------
% \cakiprimjer{oznaka}{tekst}{slike (CSV putanja) ili prazno}
% Oznaka ("Primjer 3.2.") dolazi iz Pythona. Okvir je blago posivljena pozadina
% bez ruba — isti pristup kao taskbox u caki-style.sty (11.9.2026.: plavi rub i
% odvojeni naslovni pečat trošili su red/prostor bez dobiti).
\newtcolorbox{cakiprimjerokvir}{
    enhanced, breakable,
    colback=MathBgLight, colframe=MathBgLight,
    boxrule=0pt, arc=3pt,
    left=8pt, right=8pt, top=5pt, bottom=5pt,
    before skip=2mm, after skip=2.2mm,
    before upper={\raggedright},
}
\newcommand{\cakiprimjer}[3]{%
    \begin{cakiprimjerokvir}
        {\sffamily\bfseries\color{MathPrimary} #1}~#2%
        \ifblank{#3}{}{\par\vspace{2mm}{\centering\cakislike{#3}\par}}%
    \end{cakiprimjerokvir}
}

% --- 11. ZADATAK ------------------------------------------------------------
% \cakizadatakskripte{oznaka}{tekst}{slike (CSV putanja) ili prazno}
% Broj zadatka u ŽUTOJ traci s crnim tekstom — preuzeto iz trenutne PreTeXt
% skripte (Caki, 30.10.2026.), jedina boja u dokumentu.
\newcommand{\cakizadatakskripte}[3]{%
    \par\addvspace{2.2mm}
    \noindent\colorbox{CakiZuta}{\color{black}\sffamily\bfseries #1}\enspace
    #2%
    \ifblank{#3}{}{\par\vspace{2mm}{\centering\cakislike{#3}\par}}%
    \par
}

% --- 10b. PONUĐENI ODGOVORI KOJI SU TABLICE (6.11.2026., Cakijev nalaz) -----
% \cakiopcijatablica{slovo}{širina}{tablica}
% Zadaci tipa „Koja tablica pripada funkciji...?" imaju ČETIRI TABLICE kao ponuđene
% odgovore. Tekstualni \mcFourOptions ih ne može složiti (tablica je blok, ne tok teksta),
% pa svaka ide u svoj minipage sa slovom iznad — ista ideja kao \cakislikeopcije u
% caki-style.sty za opcije koje su slike.
% Širinu računa Python (ovisno o broju opcija), jer on jedini zna koliko ih je.
\newcommand{\cakiopcijatablica}[3]{%
    \begin{minipage}[t]{#2\linewidth}
        \centering
        {\small\sffamily\bfseries\color{MathPrimary} #1)}\\[1mm]
        #3
    \end{minipage}\hspace{0.01\linewidth}%
}

% --- 11b. OZNAKA NEISPRAVNOG LaTeXA (5.11.2026., Cakijev nalaz) -------------
% \cakineispravno{id zadatka}{koja polja}
% Kad polje iz baze ima LaTeX koji bi srušio kompajliranje (neparan `$`, neuravnotežene
% `{ }` u matematici), stranica NE prekida gradnju nego umjesto tog teksta ispiše ovu
% oznaku. Zadatak OSTAJE na svom mjestu, pa numeracija i veza s rješenjima ostaju iste, a
% u PDF-u se točno vidi što treba popraviti u bazi. Namjerno upadljivo, ali bez boje
% (skripta je crno-bijela) - obrub + velika slova.
% Širina 0.75\linewidth, ne puna: oznaka se ispisuje IZA naslova zadatka („Zadatak 3.1.2."
% u žutoj traci), pa bi puna širina prešla desni rub (provjereno na probnom PDF-u 5.11.2026.).
\newcommand{\cakineispravno}[2]{%
    \fbox{\parbox{0.75\linewidth}{%
        \small\sffamily\bfseries NEISPRAVAN LaTeX \textendash{} nije ispisano\par
        \normalfont\footnotesize zadatak: #1 \quad polje: #2\par
        \footnotesize\itshape Popravi u bazi, osvježi podatke i generiraj PDF ponovno.%
    }}%
}

% --- 12. RJEŠENJA NA KRAJU POGLAVLJA ---------------------------------------
% Na izričit zahtjev (4.11.2026.): "rješenja na kraju poglavlja" (ne na kraju
% cijelog dokumenta kao u PreTeXt verziji).
% \cakirjesenjeskripte{oznaka}{tekst}
\newcommand{\cakirjesenjeskripte}[2]{%
    \par\noindent{\sffamily\bfseries\color{MathPrimary} #1}~#2%
    \par\vspace{1mm}
}
% Naslov bloka rješenja — tanja crta od naslova cjeline, da se ne čita kao nova
% cjelina.
\newcommand{\cakirjesenjanaslov}[1]{%
    \par\addvspace{4mm}
    \noindent{\color{MathPrimary}\sffamily\bfseries\large #1}%
    \par\vspace{1mm}\hrule height 0.6pt \color{MathPrimary}
    \vspace{2.5mm}
}

\endinput
